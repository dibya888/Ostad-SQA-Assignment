      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"firstname equals Dibya\", function () {\r\n    const responseData = pm.response.json();\r\n    pm.expect(responseData.firstname).to.eql(\"Dibya\");\r\n});"
            ]
          }
        }
      ],
