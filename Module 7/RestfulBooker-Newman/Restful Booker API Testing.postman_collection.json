  "item": [
    {
      "name": "Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response contains numeric bookingid\", function () {\r\n    const responseData = pm.response.json();\r\n    pm.expect(responseData).to.have.property(\"bookingid\");\r\n    pm.expect(responseData.bookingid).to.be.a(\"number\");\r\n});\r\n\r\npm.test(\"bookingid is saved to environment variable\", function () {\r\n    const responseData = pm.response.json();\r\n    pm.environment.set(\"bookingid\", responseData.bookingid);\r\n    pm.expect(pm.environment.get(\"bookingid\")).to.eql(responseData.bookingid);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"firstname\": \"Dibya\",\r\n  \"lastname\": \"Dhar\",\r\n  \"totalprice\": 111,\r\n  \"depositpaid\": true,\r\n  \"bookingdates\": {\r\n    \"checkin\": \"2026-10-10\",\r\n    \"checkout\": \"2026-10-15\"\r\n  },\r\n  \"additionalneeds\": \"Breakfast\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://restful-booker.herokuapp.com/booking",
          "protocol": "https",
          "host": [
            "restful-booker",
            "herokuapp",
            "com"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Generate Auth Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response contains token field\", function () {\r\n    const responseData = pm.response.json();\r\n    pm.expect(responseData).to.have.property(\"token\");\r\n});\r\n\r\npm.test(\"Token is saved to environment variable\", function () {\r\n    const responseData = pm.response.json();\r\n    pm.environment.set(\"token\", responseData.token);\r\n    pm.expect(pm.environment.get(\"token\")).to.eql(responseData.token);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"password123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://restful-booker.herokuapp.com/auth",
          "protocol": "https",
          "host": [
